# SSH credentials players use to log in (injected at runtime by entrypoint.sh)
USER_NAME=luna
USER_PASSWORD=luna

# Flag baked into the image at build time.
# NOTE: avoid a flag containing "$", which Docker Compose would try to expand.
CTF_FLAG=LUNA{TEMPLATE_REPLACE_ME_FLAG_ENV_OR_DIRECTLY}

# Optional: where the flag is written and who owns it
# FLAG_PATH=/root/flag.txt
# FLAG_OWNER=root

# Optional: unique project name per challenge
# COMPOSE_PROJECT_NAME=ctf-ssh
